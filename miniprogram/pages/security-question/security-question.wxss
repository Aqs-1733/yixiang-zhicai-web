.security-page { min-height:100vh; padding:150rpx 34rpx 70rpx; box-sizing:border-box; background:#fff8ec; color:#4d320c; }
button::after { border:none; }
.round-back { position:fixed; left:28rpx; top:58rpx; z-index:20; width:72rpx; height:72rpx; line-height:62rpx; padding:0; border-radius:50%; background:#fffdf7; border:2rpx solid #ead79f; color:#6a4308; font-size:58rpx; font-weight:900; box-shadow:0 10rpx 22rpx rgba(145,101,32,.16); }
.security-card { padding:42rpx 30rpx; border-radius:30rpx; background:#fffdf7; border:2rpx solid #ead7ae; box-shadow:0 18rpx 44rpx rgba(145,101,32,.12); }
.page-title { font-size:42rpx; font-weight:900; text-align:center; }
.page-desc { margin-top:14rpx; color:#8c6f3c; font-size:27rpx; line-height:1.6; }
.question-box { margin-top:30rpx; padding:26rpx; border-radius:22rpx; background:#fff1c2; font-size:32rpx; line-height:1.5; font-weight:900; }
.refresh-btn,.skip-btn { margin-top:16rpx; height:70rpx; line-height:70rpx; border-radius:35rpx; background:#fff8ec; border:2rpx solid #ead7ae; color:#7c570e; font-size:27rpx; font-weight:900; }
.answer-input { margin-top:28rpx; height:84rpx; padding:0 26rpx; border-radius:42rpx; background:#fff8ec; border:2rpx solid #ead7ae; font-size:30rpx; font-weight:800; }
.input-ph { color:#b8a077; }
.primary-btn { margin-top:28rpx; height:84rpx; line-height:84rpx; border-radius:42rpx; background:#ffc94a; color:#5f3a06; font-size:31rpx; font-weight:900; }

/* ========== 全局字号适配 ========== */
.font-global-large .round-back { font-size: 66rpx; }
.font-global-large .page-title { font-size: 50rpx; }
.font-global-large .page-desc { font-size: 33rpx; }
.font-global-large .question-box { font-size: 38rpx; }
.font-global-large .refresh-btn,
.font-global-large .skip-btn { font-size: 33rpx; height: 78rpx; line-height: 78rpx; }
.font-global-large .answer-input { font-size: 36rpx; height: 92rpx; }
.font-global-large .primary-btn { font-size: 37rpx; height: 92rpx; line-height: 92rpx; }

.font-global-xlarge .round-back { font-size: 74rpx; }
.font-global-xlarge .page-title { font-size: 58rpx; }
.font-global-xlarge .page-desc { font-size: 39rpx; }
.font-global-xlarge .question-box { font-size: 44rpx; }
.font-global-xlarge .refresh-btn,
.font-global-xlarge .skip-btn { font-size: 39rpx; height: 86rpx; line-height: 86rpx; }
.font-global-xlarge .answer-input { font-size: 42rpx; height: 100rpx; }
.font-global-xlarge .primary-btn { font-size: 43rpx; height: 100rpx; line-height: 100rpx; }
