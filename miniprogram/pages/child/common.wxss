.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 152rpx 28rpx 88rpx;
  background: #fff8ec;
  color: #4d320c;
  overflow-x: hidden;
}

.child-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.back-btn {
  width: 72rpx;
  min-width: 72rpx;
  height: 72rpx;
  line-height: 1;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #fffdf7;
  border: 2rpx solid #ead79f;
  color: #7c570e;
  font-size: 46rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(151, 108, 38, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn::after,
.primary::after,
.soft::after,
.grid button::after {
  border: none;
}

.nav-label {
  font-size: 26rpx;
  color: #9b835a;
  font-weight: 800;
}

.title {
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #4d320c;
  margin-bottom: 22rpx;
}

.card,
.summary {
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid #ead79f;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 26rpx rgba(151, 108, 38, 0.07);
}

.card.high {
  border-color: #f4a678;
  background: #fff8f0;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  font-weight: 800;
}

.name,
.label {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 900;
  color: #4d320c;
}

.big {
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #c07a17;
}

.sub,
.safe,
.tip,
.time,
.period {
  margin-top: 12rpx;
  color: #7a613a;
  font-size: 27rpx;
  line-height: 1.6;
  font-weight: 700;
}

.safe,
.tip {
  background: #fff4d8;
  border: 1rpx solid rgba(231, 191, 80, 0.55);
  border-radius: 22rpx;
  padding: 20rpx 22rpx;
}

.tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #fff;
  background: #c45b32;
  border-radius: 20rpx;
  padding: 6rpx 14rpx;
}

.summary {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.input {
  width: 100%;
  min-height: 260rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid #ead79f;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  line-height: 1.55;
  color: #4d320c;
  font-size: 31rpx;
}

.code {
  width: 100%;
  margin-top: 42rpx;
  height: 104rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid #ead79f;
  text-align: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #4d320c;
  letter-spacing: 0;
}

.primary {
  width: 100%;
  margin: 28rpx 0 0;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 43rpx;
  background: linear-gradient(180deg, #ffe28a 0%, #ffc94a 100%);
  color: #5d3a08;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 22rpx rgba(198, 126, 15, 0.12);
}

.soft {
  margin-top: 18rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  background: #fff4d8;
  color: #7c570e;
  font-weight: 900;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 20rpx 0;
}

.grid button {
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 39rpx;
  background: #fff1c2;
  color: #7c570e;
  font-size: 27rpx;
  font-weight: 900;
}

.grid button:nth-child(even) {
  background: linear-gradient(135deg, #eff9e8 0%, #d2edc4 100%);
  color: #456234;
}

.perm {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(226, 199, 139, 0.48);
  color: #7a613a;
}

.on {
  color: #c07a17;
  font-weight: 900;
}

.off {
  color: #a96a4b;
  font-weight: 800;
}

.period {
  color: #9b835a;
}

.summary text {
  color: #4d320c;
}

.report-summary {
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.55;
  font-weight: 900;
  color: #4d320c;
}

.font-global-large .title { font-size: 48rpx !important; }
.font-global-large .name,
.font-global-large .label,
.font-global-large .report-summary { font-size: 44rpx !important; }
.font-global-large .sub,
.font-global-large .safe,
.font-global-large .tip,
.font-global-large .time,
.font-global-large .period,
.font-global-large .nav-label,
.font-global-large .grid button,
.font-global-large .primary,
.font-global-large .soft { font-size: 40rpx !important; }

.font-global-xlarge .title { font-size: 58rpx !important; }
.font-global-xlarge .name,
.font-global-xlarge .label,
.font-global-xlarge .report-summary { font-size: 54rpx !important; }
.font-global-xlarge .sub,
.font-global-xlarge .safe,
.font-global-xlarge .tip,
.font-global-xlarge .time,
.font-global-xlarge .period,
.font-global-xlarge .nav-label,
.font-global-xlarge .grid button,
.font-global-xlarge .primary,
.font-global-xlarge .soft { font-size: 50rpx !important; }
