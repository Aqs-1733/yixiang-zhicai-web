@import "../common.wxss";
.location-card{padding:34rpx 28rpx;border-radius:28rpx;background:linear-gradient(145deg,#fbfff9,#e5f4e2);border:2rpx solid #c9e1bd;box-shadow:0 12rpx 28rpx rgba(91,132,70,.1);text-align:center}.location-icon{width:82rpx;height:82rpx;line-height:82rpx;margin:0 auto;border-radius:50%;background:linear-gradient(135deg,#bfe6a9,#75bd68);color:#fff;font-size:38rpx}.location-label{margin-top:20rpx;color:#456234;font-size:29rpx;font-weight:900}.location-address{margin-top:18rpx;color:#2f3e27;font-size:36rpx;line-height:1.5;font-weight:900}.time{margin-top:16rpx;color:#748267;font-size:24rpx;font-weight:750}.location-note{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #d5e7ce;color:#7b8872;font-size:23rpx;line-height:1.45}.denied{background:#fff0e8;color:#9c5338}.font-global-large .location-address{font-size:42rpx}.font-global-xlarge .location-address{font-size:50rpx}
