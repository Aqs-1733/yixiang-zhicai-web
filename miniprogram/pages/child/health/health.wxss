@import "../common.wxss";
.care-summary{margin-bottom:20rpx;padding:20rpx 24rpx;border-radius:22rpx;background:linear-gradient(135deg,#fff8d9,#edf8e7);border:2rpx solid #dfdfa9;color:#5d4b27;font-size:27rpx;line-height:1.5;font-weight:850}.care-section{margin-bottom:20rpx;padding:24rpx;border-radius:24rpx;border:2rpx solid #d7e8ca;background:linear-gradient(145deg,#fbfff8,#edf8e8);box-sizing:border-box}.care-section.meal{border-color:#eed69d;background:linear-gradient(145deg,#fffdf8,#fff3d8)}.care-section.exercise{border-color:#c6ded6;background:linear-gradient(145deg,#fafffd,#e5f4ef)}.care-title{font-size:34rpx;font-weight:900;color:#3f512e}.meal .care-title{color:#705019}.exercise .care-title{color:#315f50}.care-empty{padding:24rpx 0 8rpx;color:#8d7955;font-size:26rpx}.care-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-top:1rpx solid rgba(150,184,126,.32)}.care-main{min-width:0;flex:1;color:#354226;font-size:30rpx;font-weight:900}.care-main text{display:block;margin-top:6rpx;color:#768464;font-size:24rpx}.care-side{text-align:right;color:#5d6d49;font-size:25rpx;font-weight:850}.care-side view{margin-top:6rpx;color:#51813c;font-size:22rpx}.journal-row{padding:20rpx 0;border-top:1rpx solid rgba(205,178,114,.34)}.journal-content{color:#49391c;font-size:29rpx;font-weight:900}.journal-analysis{margin-top:8rpx;color:#6f5b34;font-size:25rpx;line-height:1.55;font-weight:750}.journal-time{margin-top:8rpx;color:#9a8765;font-size:22rpx}.denied{background:#fff0e8;color:#9c5338}.font-global-large .care-title{font-size:39rpx}.font-global-large .care-main,.font-global-large .journal-content{font-size:34rpx}.font-global-xlarge .care-title{font-size:46rpx}.font-global-xlarge .care-main,.font-global-xlarge .journal-content{font-size:40rpx}
