.profile-page{position:relative;min-height:100vh;padding:150rpx 28rpx 80rpx;background:#fff8ec;color:#4d320c;box-sizing:border-box;overflow:hidden}.profile-bg{position:absolute;left:0;top:0;width:750rpx;opacity:.35;pointer-events:none}.round-back{position:absolute;left:28rpx;top:66rpx;width:76rpx;height:76rpx;border-radius:50%;background:#fffdf7;border:2rpx solid #ead79f;box-shadow:0 8rpx 20rpx rgba(145,101,32,.14);display:flex;align-items:center;justify-content:center;font-size:52rpx;font-weight:900;z-index:3}.profile-title{position:relative;z-index:2;font-size:48rpx;font-weight:900;margin-bottom:26rpx}.profile-card{position:relative;z-index:2;padding:34rpx 28rpx;border-radius:28rpx;background:rgba(255,253,247,.97);border:2rpx solid #ead79f;box-shadow:0 12rpx 30rpx rgba(151,108,38,.1);text-align:center}.avatar-button{width:146rpx;height:146rpx;margin:0 auto;padding:0;border-radius:50%;overflow:hidden;background:#fff1c2;border:5rpx solid #ffd568}.avatar-button::after{border:none}.avatar{width:100%;height:100%;border-radius:50%}.avatar-tip{margin:12rpx 0 24rpx;color:#98763c;font-size:24rpx;font-weight:800}.nickname{height:78rpx;padding:0 24rpx;border-radius:39rpx;background:#fff8ec;border:2rpx solid #ead7ae;font-size:30rpx;font-weight:900;text-align:left;box-sizing:border-box}.account-row{display:flex;justify-content:space-between;gap:24rpx;padding:22rpx 8rpx;border-bottom:1rpx solid #f0dfb8;font-size:28rpx;font-weight:800}.account-row text:last-child{color:#8d7448}.save-button,.logout-button{height:82rpx;line-height:82rpx;border-radius:41rpx;font-size:30rpx;font-weight:900}.save-button{margin-top:28rpx;background:#ffc94a;color:#5f3a06}.logout-button{position:relative;z-index:2;width:100%;margin-top:28rpx;background:#fffdf7;border:2rpx solid #e7cfa0;color:#985b35}.save-button::after,.logout-button::after{border:none}
.avatar-button{display:block!important;width:146rpx!important;min-width:146rpx!important;max-width:146rpx!important;height:146rpx!important;min-height:146rpx!important;max-height:146rpx!important;aspect-ratio:1/1;box-sizing:border-box!important}
.avatar{display:block;object-fit:cover}
.profile-page{padding-bottom:190rpx!important;overflow-x:hidden!important;overflow-y:auto!important}.family-binding-card{display:block!important;margin-top:22rpx;text-align:left}.binding-title{font-size:34rpx;font-weight:900}.binding-desc{margin-top:8rpx;color:#8d7448;font-size:25rpx;line-height:1.5;font-weight:800}.bind-button{width:100%;margin-top:18rpx;text-align:center}.bound-member-list{margin-top:16rpx}.bound-member{display:flex;justify-content:space-between;padding:15rpx 4rpx;border-top:1rpx solid #f0dfb8;color:#6c5129;font-size:26rpx;font-weight:850}.child-bottom-nav{position:fixed;left:20rpx;right:20rpx;bottom:calc(18rpx + env(safe-area-inset-bottom));height:108rpx;padding:10rpx 14rpx;border-radius:54rpx;background:rgba(255,253,247,.98);border:2rpx solid #ead79f;box-shadow:0 12rpx 34rpx rgba(101,65,9,.18);display:flex;align-items:center;z-index:900;box-sizing:border-box}.child-nav-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3rpx;color:#896a35;font-size:22rpx;font-weight:900}.child-nav-item.active{color:#a86708}.child-nav-icon{width:48rpx;height:48rpx;border-radius:50%;background:#fff1c2;display:flex;align-items:center;justify-content:center;font-size:24rpx}.child-nav-item.active .child-nav-icon{background:#ffc94a}
