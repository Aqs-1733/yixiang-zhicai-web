.forgot-page { min-height:100vh; padding:150rpx 34rpx 70rpx; box-sizing:border-box; background:#fff8ec; color:#4d320c; }
button::after { border:none; }
.round-back { position:fixed; left:28rpx; top:58rpx; width:72rpx; height:72rpx; line-height:62rpx; padding:0; border-radius:50%; background:#fffdf7; border:2rpx solid #ead79f; color:#6a4308; font-size:58rpx; font-weight:900; box-shadow:0 10rpx 22rpx rgba(145,101,32,.16); }
.forgot-card { padding:42rpx 30rpx; border-radius:30rpx; background:#fffdf7; border:2rpx solid #ead7ae; box-shadow:0 18rpx 44rpx rgba(145,101,32,.12); }
.page-title { font-size:42rpx; font-weight:900; text-align:center; }
.page-desc { margin:14rpx 0 26rpx; color:#8c6f3c; font-size:27rpx; line-height:1.6; }
.form-input { margin-top:18rpx; height:84rpx; padding:0 26rpx; border-radius:42rpx; background:#fff8ec; border:2rpx solid #ead7ae; font-size:30rpx; }
.question-box { margin-top:26rpx; padding:24rpx; border-radius:22rpx; background:#fff1c2; font-size:31rpx; line-height:1.5; font-weight:900; }
.soft-btn,.primary-btn { margin-top:22rpx; height:82rpx; line-height:82rpx; border-radius:41rpx; font-size:30rpx; font-weight:900; }
.soft-btn { background:#fff8ec; border:2rpx solid #e5c77d; color:#725018; }
.primary-btn { background:#ffc94a; color:#5f3a06; }

/* ========== 全局字号适配 ========== */
.font-global-large .round-back { font-size: 66rpx; }
.font-global-large .page-title { font-size: 50rpx; }
.font-global-large .page-desc { font-size: 33rpx; }
.font-global-large .form-input { font-size: 36rpx; height: 92rpx; }
.font-global-large .question-box { font-size: 37rpx; }
.font-global-large .soft-btn,
.font-global-large .primary-btn { font-size: 36rpx; height: 90rpx; line-height: 90rpx; }

.font-global-xlarge .round-back { font-size: 74rpx; }
.font-global-xlarge .page-title { font-size: 58rpx; }
.font-global-xlarge .page-desc { font-size: 39rpx; }
.font-global-xlarge .form-input { font-size: 42rpx; height: 100rpx; }
.font-global-xlarge .question-box { font-size: 43rpx; }
.font-global-xlarge .soft-btn,
.font-global-xlarge .primary-btn { font-size: 42rpx; height: 98rpx; line-height: 98rpx; }
