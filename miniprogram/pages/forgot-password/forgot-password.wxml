<view class="forgot-page {{globalFontPageClass}}">
  <button class="round-back" hover-class="none" bindtap="back">‹</button>
  <view class="forgot-card">
    <view class="page-title">忘记密码</view>
    <view class="page-desc">输入注册手机号，回答注册时设置的问题。</view>
    <input class="form-input" type="number" maxlength="11" value="{{phone}}" data-k="phone" bindinput="onInput" placeholder="注册手机号" />
    <button class="soft-btn" bindtap="loadQuestion">查看密保问题</button>
    <block wx:if="{{question}}">
      <view class="question-box">{{question}}</view>
      <input class="form-input" value="{{answer}}" data-k="answer" bindinput="onInput" placeholder="密保答案" />
      <input class="form-input" password="true" value="{{newPassword}}" data-k="newPassword" bindinput="onInput" placeholder="设置新密码（至少4位）" />
      <button class="primary-btn" bindtap="resetPassword">重置密码</button>
    </block>
  </view>
</view>
