}

/* 分类选择网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-item {
  width: calc(33.333% - 14rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 2rpx solid rgba(226, 199, 139, 0.4);
  transition: all 0.2s;
}

.category-item:active {
  transform: scale(0.96);
}

.category-selected {
  background: #fff1c2;
  border-color: #ffc43b;
}

.category-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #5a3a0c;
}

.category-selected .category-name {
  color: #8b5a0c;
}

/* 金额输入 */
.amount-input-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid rgba(226, 199, 139, 0.4);
}

.amount-symbol {
  font-size: 40rpx;
  font-weight: 900;
  color: #ff914d;
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  font-size: 44rpx;
  font-weight: 900;
  color: #5a3a0c;
}

/* 备注输入 */
.description-input {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #5a3a0c;
  border: 2rpx solid rgba(226, 199, 139, 0.4);
  box-sizing: border-box;
}

.input-placeholder {
  color: #c4b599;
}

/* 底部按钮 */
.panel-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx;
  border-top: 1rpx solid rgba(226, 199, 139, 0.4);
}

.panel-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.panel-btn::after {
  border: none;
}

.panel-btn-cancel {
  background: #f5f0e6;
  color: #8b7355;
}

.panel-btn-confirm {
  background: linear-gradient(180deg, #ffe28a 0%, #ffc94a 100%);
  color: #6a4308;
  box-shadow: 0 8rpx 18rpx rgba(190, 118, 18, 0.2);
}

/* ========== 录音浮层样式 ========== */
.record-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.record-pulse {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 145, 77, 0.2);
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.2);
    opacity: 0.4;
  }
}

.record-text {
  margin-top: 40rpx;
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

.record-hint {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ========== 工具类 ========== */
.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.small {
  font-size: 28rpx;
  color: #9b835a;
  margin-top: 8rpx;
}

.card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20rpx;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 6000;
  background: rgba(60, 39, 10, 0.34);
  display: flex;
  align-items: flex-end;
}

.detail-panel {
  width: 100%;
  max-height: 74vh;
  overflow-y: auto;
  padding: 30rpx 34rpx env(safe-area-inset-bottom);
  border-radius: 34rpx 34rpx 0 0;
  background: #fffdf7;
  border-top: 2rpx solid #ead79f;
  box-sizing: border-box;
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.detail-title {
  font-size: 36rpx;
  color: #4d320c;
  font-weight: 900;
}

.detail-close {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  border-radius: 32rpx;
  background: #fff1c2;
  color: #7c570e;
  font-size: 42rpx;
  font-weight: 900;
  text-align: center;
}

.detail-name {
  color: #4d320c;
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 900;
}

.detail-amount {
  margin-top: 12rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 900;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(226, 199, 139, 0.38);
  color: #6f5428;
  font-size: 30rpx;
  font-weight: 800;
}

.detail-row text:last-child {
  color: #4d320c;
  text-align: right;
}

.detail-desc,
.detail-source {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff8ea;
  color: #7a613a;
  font-size: 28rpx;
  line-height: 1.55;
  font-weight: 800;
}

.detail-source {
  background: #fff4dc;
  color: #8a5b12;
  max-height: 150rpx;
  overflow-y: auto;
}

.detail-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.detail-actions button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: 38rpx;
  background: #fff1c2;
  color: #7a520f;
  font-size: 30rpx;
  font-weight: 900;
}

.detail-actions button:last-child {
  background: #fff0e7;
  color: #a85025;
}

.detail-actions button::after {
  border: none;
}

.pocket-detail-panel {
  max-height: 80vh;
}

.position-detail-panel {
  max-height: 86vh;
}

.position-action-bar { position:sticky; top:0; z-index:3; display:grid; grid-template-columns:repeat(4,1fr); gap:10rpx; margin:0 0 22rpx; padding:10rpx 0 14rpx; background:#fffdf7; }
.position-action-bar button { min-width:0; height:66rpx; line-height:66rpx; margin:0; padding:0 8rpx; border-radius:33rpx; background:#fff1c2; color:#72500f; font-size:25rpx; font-weight:900; }
.position-action-bar button.assistant { background:#e8f5df; color:#4f7136; }
.position-action-bar button.danger { background:#fff0e7; color:#a85025; }
.position-action-bar button::after { border:none; }
.position-ask-box { margin-top:20rpx; padding:16rpx; border-radius:22rpx; background:#f3f8ea; border:2rpx solid #d6e8c8; }
.position-ask-messages { height:320rpx; }
.position-ask-message { width:84%; margin:12rpx 0; padding:15rpx 18rpx; border-radius:18rpx; color:#5c4420; font-size:26rpx; line-height:1.55; box-sizing:border-box; }
.position-ask-message.assistant { background:#fffdf7; border:1rpx solid #ead79f; }
.position-ask-message.user { margin-left:auto; background:#ffe6a3; }
.position-ask-input-row { display:flex; gap:10rpx; margin-top:12rpx; }
.position-ask-input-row input { flex:1; min-width:0; height:68rpx; padding:0 20rpx; border-radius:34rpx; background:#fff; border:2rpx solid #e1d3ac; font-size:25rpx; box-sizing:border-box; }
.position-ask-input-row button { width:116rpx; height:68rpx; line-height:68rpx; margin:0; padding:0; border-radius:34rpx; background:#ffc94a; color:#5d3a08; font-size:25rpx; font-weight:900; }
.position-ask-input-row button::after { border:none; }
.inline-product-ask { margin-bottom:18rpx; }
.inline-ask-head { display:flex; align-items:center; justify-content:space-between; min-height:58rpx; color:#5a3a0c; font-size:29rpx; font-weight:900; }
.inline-ask-close { flex:none; width:56rpx; height:56rpx; line-height:52rpx; margin:0; padding:0; border-radius:50%; background:#fff; color:#6b4f2a; font-size:34rpx; font-weight:900; box-shadow:0 6rpx 16rpx rgba(88,62,18,.16); }
.inline-ask-close::after { border:none; }

.pocket-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.pocket-tags text {
  padding: 8rpx 14rpx;
  border-radius: 18rpx;
  background: #fff1c2;
  color: #79530f;
  font-size: 23rpx;
  font-weight: 900;
}

