/* 家人绑定码按钮：修正文字居中 */
.bind-existing-family{
  width:100%;
  height:70rpx;
  line-height:70rpx;
  margin:12rpx 0 0;
  padding:0;
  border-radius:35rpx;
  background:#fffdf7;
  color:#6e5527;
  border:1rpx solid #d9e8bd;
  font-size:25rpx;
  font-weight:900;
  text-align:center;
  box-sizing:border-box;
}

/* 退出登录按钮：修正文字居中 */
.logout-btn{
  width:698rpx;
  height:68rpx;
  line-height:68rpx;
  display:block;
  margin:18rpx auto 26rpx;
  padding:0;
  border-radius:34rpx;
  background:#fff4d8;
  color:#8a6819;
  font-size:29rpx;
  font-weight:900;
  text-align:center;
  box-sizing:border-box;
}

.bind-existing-family::after,
.logout-btn::after{
  border:none;
}