.profile-page {
  position: relative;
  min-height: 100vh;
  background: #fff8ec;
  overflow: hidden;
}

.profile-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: auto;
  z-index: 0;
}

.profile-scroll {
  position: relative;
  z-index: 2;
  height: 100vh;
  box-sizing: border-box;
  padding: 230rpx 26rpx 30rpx;
}

.profile-action-row {
  width: 698rpx;
  margin: 0 auto 18rpx;
  display: flex;
  justify-content: flex-end;
}

.top-logout-btn {
  width: 168rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0;
  margin: 0;
  border-radius: 29rpx;
  background: #fffdf7;
  border: 2rpx solid #ead79f;
  color: #7c570e;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(151, 108, 38, 0.06);
}

.top-logout-btn::after {
  border: none;
}

/* 通用卡片：白色干净背景 */
.top-card,
.analysis-card,
.data-card,
.fraud-card {
  width: 698rpx;
  box-sizing: border-box;
  overflow: hidden;
  margin: 0 auto 26rpx;
  padding: 26rpx 34rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(237, 209, 147, 0.78);
  box-shadow: 0 14rpx 34rpx rgba(161, 111, 29, 0.10);
}

/* 顶部头像昵称卡片 */
.top-card {
  min-height: 178rpx;
  padding: 24rpx 28rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  gap: 26rpx;
}

/* 顶部头像昵称卡片：保证头像在最上层 */
.top-card {
  position: relative;
  z-index: 50;
  overflow: visible;
}

/* 外层头像圆环：整体变大 */
.avatar-ring {
  width: 158rpx;
  height: 158rpx;
  border-radius: 50%;
  background: rgba(255, 244, 208, 0.96);
  border: 4rpx solid #ffd35a;
  box-shadow: 0 8rpx 20rpx rgba(180, 120, 30, 0.14);

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;
  position: relative;
  z-index: 999;
  overflow: visible;
}

/* 选择头像按钮：也要置顶 */
.avatar-btn {
  width: 138rpx;
  height: 138rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;
  z-index: 1000;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

/* 真正头像图片完整填满圆形 */
.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: block;
  position: relative;
  z-index: 1001;
}
.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14rpx;
}

.nick-display {
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  font-size: 34rpx;
  font-weight: 900;
  color: #4d320c;
  text-align: center;
}

.nick-input {
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  font-size: 34rpx;
  font-weight: 900;
  color: #4d320c;
  text-align: center;
  background: rgba(255, 248, 230, 0.7);
  border-radius: 30rpx;
}

.nick-hint {
  text-align: center;
  font-size: 22rpx;
  color: #b8a06e;
  margin-top: 8rpx;
}

.user-tip {
  display: none;
}

.input-placeholder {
  color: #cbbd9c;
  font-size: 28rpx;
  font-weight: 400;
}

.font-global-large .nick-display,
.font-global-large .nick-input,
.font-global-large .small,
.font-global-large .reason-text,
.font-global-large .summary-text,
.font-global-large .data-label,
.font-global-large .data-value,
.font-global-large .fraud-content,
.font-global-large .tag-item,
.font-global-large .highlight-label,
.font-global-large .highlight-value,
.font-global-large .suggestion-text {
  font-size: 32rpx;
}

.font-global-large .section-title,
.font-global-large .highlight-icon,
.font-global-large .suggestion-icon {
  font-size: 40rpx;
}

.font-global-large .score {
  font-size: 38rpx;
}

.font-global-large .level {
  font-size: 32rpx;
}

.font-global-large .mini-btn {
  font-size: 30rpx;
}

.font-global-xlarge .nick-display,
.font-global-xlarge .nick-input,
.font-global-xlarge .small,
.font-global-xlarge .reason-text,
.font-global-xlarge .summary-text,
.font-global-xlarge .data-label,
.font-global-xlarge .data-value,
.font-global-xlarge .fraud-content,
.font-global-xlarge .tag-item,
.font-global-xlarge .highlight-label,
.font-global-xlarge .highlight-value,
.font-global-xlarge .suggestion-text {
  font-size: 42rpx;
}

.font-global-xlarge .section-title,
.font-global-xlarge .score,
.font-global-xlarge .level,
.font-global-xlarge .highlight-icon,
.font-global-xlarge .suggestion-icon {
  font-size: 51rpx;
}

.font-global-xlarge .mini-btn {
  font-size: 36rpx;
  width: 176rpx;
  height: 64rpx;
  line-height: 64rpx;
}
.font-global-xlarge .nick-hint { font-size: 28rpx; }
.font-global-xlarge .reassess-text { font-size: 36rpx; }
.font-global-xlarge .reassess-card { padding: 28rpx; }
.font-global-xlarge .edit-title { font-size: 42rpx; }
.font-global-xlarge .edit-input { height: 88rpx; line-height: 88rpx; font-size: 38rpx; }
.font-global-xlarge .choice-item { height: 78rpx; line-height: 78rpx; font-size: 36rpx; min-width: 170rpx; }
.font-global-xlarge .edit-cancel,
.font-global-xlarge .edit-confirm { height: 80rpx; line-height: 80rpx; font-size: 34rpx; }
.font-global-xlarge .logout-btn { height: 80rpx; line-height: 80rpx; font-size: 36rpx; width: 698rpx; }
.font-global-xlarge .top-logout-btn { height: 68rpx; line-height: 68rpx; font-size: 32rpx; width: 190rpx; }

/* 标题行 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 35rpx;
  font-weight: 900;
  color: #4d320c;
}

/* 重新评估入口卡片 */
.reassess-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 0 22rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(232, 202, 134, 0.65);
}

.reassess-icon {
  font-size: 36rpx;
}

.reassess-text {
  font-size: 30rpx;
  font-weight: 900;
  color: #5a3a0c;
}

.mini-btn {
  width: 156rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0;
  margin: 0;
  border-radius: 27rpx;
  border: none;
  background: #fff0bd;
  color: #7c570e;
  font-size: 27rpx;
  font-weight: 900;
}

.mini-btn::after {
  border: none;
}

/* 风险评估卡片 */
.analysis-card {
  border-radius: 36rpx;
}

.risk-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.risk-score,
.risk-level {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #fff8e5, #fff0bd);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(229, 196, 111, 0.55);
}

.score {
  font-size: 32rpx;
  font-weight: 900;
  color: #c98514;
}

.level {
  font-size: 26rpx;
  font-weight: 900;
  color: #9a6b13;
}

.small {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #9b835a;
}

.summary-text {
  display: none;
}

.reason-text {
  display: none;
}

/* 分条要点列表 */
.highlight-list {
  margin-top: 4rpx;
}

.highlight-item {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid rgba(226, 199, 139, 0.35);
}

.highlight-item:last-child {
  border-bottom: none;
}

.highlight-icon {
  font-size: 30rpx;
  width: 48rpx;
  flex-shrink: 0;
}

.highlight-label {
  font-size: 26rpx;
  color: #9b835a;
  font-weight: 800;
  width: 80rpx;
  flex-shrink: 0;
}

.highlight-value {
  font-size: 28rpx;
  color: #4d320c;
  font-weight: 900;
  flex: 1;
  padding-left: 40rpx;
}

/* 核心建议条 */
.suggestion-box {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #fff7df, #fff0c4);
  border-left: 6rpx solid #f0b82c;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.suggestion-icon {
  font-size: 30rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.suggestion-text {
  font-size: 28rpx;
  line-height: 1.55;
  color: #6b420d;
  font-weight: 800;
  flex: 1;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.tag-item {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fff4d8;
  color: #8a6819;
  font-size: 30rpx;
  font-weight: 800;
  border: 1rpx solid rgba(231, 191, 80, 0.45);
}

.explainable-text {
  text-decoration: underline;
  text-decoration-thickness: 4rpx;
  text-underline-offset: 8rpx;
  text-decoration-color: #c87d1e;
}

.term-inline-profile {
  text-decoration-line: underline;
  text-decoration-style: double;
  text-decoration-thickness: 4rpx;
  text-underline-offset: 7rpx;
  text-decoration-color: rgba(190, 135, 32, 0.78);
  color: inherit;
  font-weight: 900;
}

/* 基础画像信息 */
.data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 72rpx;
  border-bottom: 1rpx solid rgba(226, 199, 139, 0.4);
  font-size: 28rpx;
}

.data-row:last-child {
  border-bottom: none;
}

/* 左边名词：点击解释 */
.data-label {
  color: #9b835a;
  font-size: 32rpx;
  padding: 18rpx 0  24rpx;
  flex-shrink: 0;
}

/* 右边数值：点击修改 */
.data-value {
  color: #4d320c;
  font-weight: 900;
  font-size: 32rpx;
  padding: 18rpx 0 18rpx 24rpx;
  text-align: right;
  flex: 1;
}

/* 防诈提醒 */
.fraud-content {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff8e6;
  color: #8a5b12;
  font-size: 28rpx;
  line-height: 1.6;
}

.logout-btn {
  width: 698rpx;
  display: block;
  margin: 0 auto 26rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0;
  margin: 0;
  border-radius: 34rpx;
  background: #fff4d8;
  color: #8a6819;
  font-size: 29rpx;
  font-weight: 900;
}

.logout-btn::after {
  border: none;
}

.bottom-space {
  height: 130rpx;
}

/* 修改画像弹窗 */
.edit-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(63, 42, 10, 0.28);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-panel {
  width: 620rpx;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid rgba(237, 209, 147, 0.9);
  box-shadow: 0 18rpx 50rpx rgba(93, 62, 18, 0.18);
  box-sizing: border-box;
}

.edit-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #4d320c;
  margin-bottom: 24rpx;
}

.edit-input {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #fffaf0;
  border: 2rpx solid #ead7ae;
  font-size: 32rpx;
  color: #4d320c;
}

.choice-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.choice-item {
  min-width: 150rpx;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  padding: 0 24rpx;
  border-radius: 33rpx;
  background: #fff8e6;
  border: 2rpx solid #ead7ae;
  color: #7c570e;
  font-size: 30rpx;
  font-weight: 800;
}

.choice-active {
  background: #ffd867;
  border-color: #ffbd33;
  color: #60400d;
}

.edit-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.edit-cancel,
.edit-confirm {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  font-size: 28rpx;
  font-weight: 900;
  padding: 0;
  margin: 0;
}

.edit-cancel {
  background: #fff8e6;
  color: #8a6819;
}

.edit-confirm {
  background: linear-gradient(180deg, #ffd867, #ffbd33);
  color: #60400d;
}

.edit-cancel::after,
.edit-confirm::after {
  border: none;
}

