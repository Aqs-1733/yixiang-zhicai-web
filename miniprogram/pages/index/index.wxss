/* ======== 家庭协同弹窗 ======== */
.family-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 28, 8, 0.45);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.family-panel {
  width: 750rpx;
  max-height: 70vh;
  padding: 34rpx 30rpx 50rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: #fffdf7;
  box-sizing: border-box;
  overflow-y: auto;
}

.family-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.family-panel-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #4d320c;
}

.family-panel-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #f5eed8;
  color: #8a6819;
  font-size: 32rpx;
  font-weight: 900;
}

.home-permission-mask{position:fixed;inset:0;z-index:10020;display:flex;align-items:center;justify-content:center;padding:30rpx;background:rgba(40,28,8,.44);box-sizing:border-box}.home-permission-panel{width:100%;max-height:88vh;padding:30rpx;border-radius:30rpx;background:#fffdf7;border:2rpx solid #ead79f;box-shadow:0 18rpx 54rpx rgba(71,47,12,.24);box-sizing:border-box;overflow-y:auto}.home-permission-title{font-size:38rpx;font-weight:900;color:#3e2c12}.home-permission-note{margin:10rpx 0 14rpx;color:#806b46;font-size:25rpx;line-height:1.5;font-weight:750}.home-permission-panel label{min-height:76rpx;padding:0 6rpx;border-bottom:1rpx solid #ecdcb8;display:flex;align-items:center;justify-content:space-between;color:#553c17;font-size:29rpx;font-weight:900}.home-permission-panel switch{transform:scale(.84);transform-origin:right center}.home-permission-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.home-permission-actions button{width:100%;height:74rpx;line-height:74rpx;margin:0;padding:0;border-radius:38rpx;background:linear-gradient(135deg,#fff8e7,#f3ead8);color:#73552a;font-size:28rpx;font-weight:900;box-sizing:border-box}.home-permission-actions button.save{background:linear-gradient(135deg,#ffd86b,#ffba31);color:#5d3a08}.home-permission-actions button::after{border:none}.font-global-xlarge .home-permission-panel label{font-size:35rpx;min-height:90rpx}

/* 邀请码区域 */
.family-code-section {
  padding: 24rpx;
  margin-bottom: 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff8e5, #fff0c4);
  border: 2rpx solid rgba(235, 196, 80, 0.4);
}

.family-section-label {
  font-size: 32rpx;
  font-weight: 900;
  color: #5a3a0c;
  margin-bottom: 6rpx;
}

.family-section-desc {
  font-size: 24rpx;
  color: #9b835a;
  margin-bottom: 18rpx;
}

.family-code-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.family-code-text {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 2rpx solid #ebd19f;
  font-size: 44rpx;
  font-weight: 900;
  color: #6b420d;
  text-align: center;
  letter-spacing: 8rpx;
}

.family-code-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #ffd86c, #f0b82c);
  color: #4d320c;
  font-size: 28rpx;
  font-weight: 900;
  border: none;
}

.family-code-btn::after {
  border: none;
}

/* 权限区域 */
.family-perm-section {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(235, 207, 147, 0.65);
}

.family-empty-hint {
  padding: 24rpx 0;
  color: #9b835a;
  font-size: 26rpx;
  text-align: center;
}

.family-member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid rgba(226, 199, 139, 0.35);
}

.family-member-row:last-child {
  border-bottom: none;
}

.family-member-info {
  flex: 1;
  min-width: 0;
}

.family-member-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #4d320c;
}

.family-member-phone {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9b835a;
}

.family-perm-toggles {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
}

.family-perm-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.family-perm-label {
  font-size: 26rpx;
  color: #7a5a1a;
  font-weight: 800;
}

.family-more-row {
  margin-top: 8rpx;
  text-align: center;
}

.family-more-btn {
  display: inline-block;
  width: 280rpx;
  height: 66rpx;
  line-height: 66rpx;
  padding: 0;
  margin: 0;
  border-radius: 33rpx;
  background: rgba(255, 252, 245, 0.98);
  border: 2rpx solid #ebd7a7;
  color: #7a5a1a;
  font-size: 28rpx;
  font-weight: 800;
}

.family-more-btn::after {
  border: none;
}
