.common-func-item:nth-child(even){background:linear-gradient(180deg,#f1faeb 0%,#d8efc7 100%);border-color:rgba(151,201,119,.58);box-shadow:0 10rpx 24rpx rgba(96,150,69,.06)}
.common-func-item:nth-child(even) .common-func-item-label{color:#456234}
