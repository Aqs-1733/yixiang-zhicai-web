.home-message-mini{margin-top:22rpx;padding:20rpx 24rpx;border-radius:24rpx;background:linear-gradient(135deg,#fff6c9,#ffe18a);border:2rpx solid #eacf83;display:flex;align-items:center;justify-content:space-between;box-shadow:0 8rpx 20rpx rgba(174,125,35,.1)}
