.msg-page{position:relative;width:750rpx;height:100vh;overflow:hidden;background:#fff8ec;color:#4d320c}.msg-bg{position:absolute;left:0;top:0;width:750rpx;z-index:0}.message-overlay{position:fixed;inset:0;z-index:10;padding:170rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));display:flex;align-items:flex-start;justify-content:center;background:rgba(72,52,21,.16);box-sizing:border-box}.message-dialog{position:relative;width:100%;max-height:calc(100vh - 230rpx);padding:34rpx 30rpx 30rpx;border-radius:30rpx;background:rgba(255,253,247,.98);border:2rpx solid #ead79f;box-shadow:0 22rpx 60rpx rgba(82,55,12,.24);box-sizing:border-box}.dialog-close{position:absolute;right:22rpx;top:20rpx;width:62rpx;height:62rpx;line-height:58rpx;border-radius:50%;background:#fff4d8;border:2rpx solid #ead79f;text-align:center;color:#6a4308;font-size:38rpx;font-weight:900}.dialog-title{padding-right:80rpx;font-size:42rpx;font-weight:900}.dialog-sub{margin-top:6rpx;color:#8b744c;font-size:25rpx;font-weight:750}.member-picker,.member-empty{margin-top:26rpx;min-height:82rpx;padding:0 22rpx;border-radius:22rpx;background:linear-gradient(135deg,#fff7d8,#eef8e8);border:2rpx solid #e4d69d;display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;font-size:28rpx;font-weight:900}.member-picker text{color:#8a7042;font-size:24rpx}.member-empty{justify-content:flex-start;color:#8d7957}.message-textarea{width:100%;height:210rpx;margin-top:18rpx;padding:22rpx;border-radius:22rpx;background:#fffaf0;border:2rpx solid #eadfbd;color:#4d320c;font-size:30rpx;line-height:1.55;box-sizing:border-box}.msg-ph{color:#ad9a76}.message-tools{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:16rpx}.message-tools button,.dialog-actions button,.recording-inline button{margin:0;padding:0;border:0}.message-tools button::after,.dialog-actions button::after,.recording-inline button::after{border:none}.message-tools .soft{height:66rpx;line-height:66rpx;border-radius:33rpx;background:linear-gradient(135deg,#edf8e7,#d2ebc5);color:#456234;font-size:25rpx;font-weight:900}.message-tools .history{background:linear-gradient(135deg,#fff8dc,#ffe7a6);color:#6c4b13}.recording-inline{margin-top:14rpx;padding:14rpx 18rpx;border-radius:22rpx;background:#fff0e8;color:#a54e36;display:flex;align-items:center;justify-content:space-between;font-size:25rpx;font-weight:900}.recording-inline button{width:100rpx;height:52rpx;line-height:52rpx;border-radius:26rpx;background:#e56d4f;color:#fff;font-size:23rpx}.compact-history{height:260rpx;margin-top:16rpx;padding:8rpx 4rpx;box-sizing:border-box}.history-empty{padding:28rpx;text-align:center;color:#937e5b;font-size:25rpx}.history-item{margin-bottom:12rpx;padding:16rpx 18rpx;border-radius:18rpx;background:#eef8e9;border:1rpx solid #d7e7cc}.history-item.mine{background:#fff3cd;border-color:#ecd695}.history-name{color:#7d673e;font-size:22rpx;font-weight:900}.history-content,.history-voice{margin-top:6rpx;color:#493619;font-size:26rpx;line-height:1.45;font-weight:800}.history-voice{color:#4f6c3a}.history-time{margin-top:6rpx;color:#a28b65;font-size:20rpx;text-align:right}.term-inline-msg{text-decoration-line:underline;text-decoration-style:double;text-underline-offset:6rpx;text-decoration-color:#c87d1e;font-weight:900}.dialog-actions{display:grid;grid-template-columns:1fr 1.35fr;gap:14rpx;margin-top:20rpx}.dialog-actions button{height:76rpx;line-height:76rpx;border-radius:38rpx;font-size:28rpx;font-weight:900}.dialog-actions .cancel{background:#f4eee1;color:#735c36}.dialog-actions .send{background:linear-gradient(135deg,#fff2bd,#ffd46a);color:#5d3a08}.dialog-actions button[disabled],.message-tools button[disabled]{opacity:.48}.font-global-large .dialog-title{font-size:48rpx}.font-global-large .member-picker,.font-global-large .message-textarea{font-size:35rpx}.font-global-xlarge .dialog-title{font-size:56rpx}.font-global-xlarge .member-picker,.font-global-xlarge .message-textarea{font-size:41rpx}
