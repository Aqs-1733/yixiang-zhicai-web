/* 子女端授权入口与分层配色 */
.quick-card.green{background:linear-gradient(135deg,#edf9e5,#dff2d3)}
.quick-card.orange{background:linear-gradient(135deg,#fff4d8,#ffe2ad)}
.quick-card.cream{background:linear-gradient(135deg,#fffefb,#edf6e8)}
.quick-card.soft-green{background:linear-gradient(135deg,#e8f6df,#dff2ea)}
.child-access-panel{margin-top:18rpx;padding:22rpx;border-radius:24rpx;background:rgba(255,253,247,.97);border:2rpx solid #ead79f;box-sizing:border-box}
.access-title{font-size:32rpx;font-weight:900}
.access-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:16rpx}
.access-item{min-width:0;min-height:96rpx;margin:0;padding:16rpx 18rpx;border-radius:24rpx;border:2rpx solid #d8e9c8;background:linear-gradient(135deg,#f1faea,#e2f4d8);color:#4d5e2d;text-align:left;box-sizing:border-box}
.access-item::after{border:none}
.access-item text{display:block;font-size:27rpx;font-weight:900}
.access-item view{margin-top:5rpx;font-size:21rpx;color:#66804e;font-weight:800}
.access-item.positions,.access-item.chat{border-color:#eed69d;background:linear-gradient(135deg,#fff7d8,#ffe6a8);color:#6b480e}
.access-item.risk{border-color:#f1c5ad;background:linear-gradient(135deg,#fff6eb,#ffe2cc);color:#7e4527}
.access-item.location{border-color:#c9e2dd;background:linear-gradient(135deg,#eef9f6,#dff1ed)}
.access-item.disabled{opacity:.62;background:#f4f1e9;border-color:#ddd4c3;color:#877b69}
.access-item.disabled view{color:#9a8e7c}
.analysis-card.warm{background:linear-gradient(135deg,#fff6df,#ffeac1)}
.analysis-card.green{background:linear-gradient(135deg,#eef9e7,#dff2da)}
.font-global-large .access-title{font-size:38rpx}
.font-global-large .access-item text{font-size:32rpx}
.font-global-large .access-item view{font-size:26rpx}
.font-global-xlarge .access-title{font-size:44rpx}
.font-global-xlarge .access-item text{font-size:38rpx}
.font-global-xlarge .access-item view{font-size:31rpx}
