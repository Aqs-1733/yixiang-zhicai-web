<view class="news-page {{globalFontPageClass}}">
  <image class="news-bg" src="/assets/ui/xinwen.jpg" mode="aspectFill" />

  <view class="back-btn" bindtap="back">←</view>

  <view wx:if="{{isListing}}" class="news-list-wrap">
    <view class="news-list-heading"><view>政策与资讯</view><button bindtap="loadNewsList">刷新资讯</button></view>
    <view wx:if="{{newsListLoading}}" class="news-loading">正在读取官方资讯…</view>
    <view wx:for="{{newsItems}}" wx:key="id" class="news-list-item" data-id="{{item.id}}" bindtap="openNewsItem">
      <view class="news-list-index">{{index+1}}</view><view><view class="news-list-title">{{item.title}}</view><view class="news-list-meta">{{item.source}} · {{item.published_at || item.time}}</view></view><view>›</view>
    </view>
    <view wx:if="{{articleError}}" class="news-reader-message">{{articleError}}</view>
  </view>
  <scroll-view wx:else class="news-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="news-title {{globalFontPageClass}}">{{article.title || '养老理财资讯'}}</view>

    <view wx:if="{{article.source || article.date || article.created_at}}" class="news-meta {{globalFontPageClass}}">
      {{article.source || '来源未提供'}} · {{article.date || article.created_at || '发布日期未提供'}}
    </view>

    <view class="news-body">
      <view wx:if="{{article.content_kind === 'official_excerpt'}}" class="news-reader-label">官方正文{{article.truncated ? '节选' : ''}}</view>
      <view wx:if="{{articleLoading}}" class="news-loading">
        <view class="news-loading-text {{globalFontPageClass}}">正在核对资讯来源…</view>
      </view>
      <view wx:for="{{article.paragraphs}}" wx:key="text" class="news-paragraph {{globalFontPageClass}}">
        <text
          wx:for="{{item.segments}}"
          wx:for-item="seg"
          wx:key="*this"
          class="{{seg.term ? 'term-inline-news' : ''}} {{globalFontPageClass}}"
          data-term="{{seg.term}}"
          catchtap="explainTerm"
        >{{seg.text}}</text>
      </view>
    </view>

    <view wx:if="{{articleError}}" class="news-reader-message">{{articleError}}<button bindtap="retryArticle">重新读取</button><button bindtap="goNewsList">返回资讯列表</button></view>
    <view class="news-actions">
      <button wx:if="{{article.url}}" class="{{globalFontPageClass}}" hover-class="none" bindtap="openOriginal">查看原文 ↗</button>
      <button class="{{globalFontPageClass}}" hover-class="none" bindtap="readArticle">语音朗读</button>
      <button class="{{globalFontPageClass}}" hover-class="none" bindtap="askXiang">问小享</button>
    </view>
  </scroll-view>

</view>

<term-popups popups="{{termExplainPopups}}" bind:close="closeTermPopup"></term-popups>

<voice-input type="fab" redirect-to-ask="{{false}}" visible="{{true}}" disabled="{{false}}" overlay-text="请说出关于这篇新闻的问题…" bind:result="onVoiceResult" bind:empty="onVoiceEmpty" bind:error="onVoiceError" />
