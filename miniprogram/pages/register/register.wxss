.font-global-large .form-field { height: 90rpx; }
.font-global-large .input-text { font-size: 36rpx; }
.font-global-large .role-note { font-size: 33rpx; }
.font-global-large .submit-btn { font-size: 38rpx; height: 92rpx; line-height: 92rpx; }
.font-global-large .login-link { font-size: 34rpx; height: 78rpx; line-height: 78rpx; }
.font-global-large .register-avatar-tip { font-size: 30rpx; }
.font-global-large .security-title { font-size: 34rpx; }
.font-global-large .security-desc { font-size: 29rpx; }

.font-global-xlarge .back { font-size: 74rpx; }
.font-global-xlarge .register-title { font-size: 60rpx; }
.font-global-xlarge .register-subtitle { font-size: 39rpx; }
.font-global-xlarge .role-btn { font-size: 42rpx; height: 92rpx; line-height: 92rpx; }
.font-global-xlarge .form-field { height: 98rpx; }
.font-global-xlarge .input-text { font-size: 42rpx; }
.font-global-xlarge .role-note { font-size: 39rpx; }
.font-global-xlarge .submit-btn { font-size: 44rpx; height: 100rpx; line-height: 100rpx; }
