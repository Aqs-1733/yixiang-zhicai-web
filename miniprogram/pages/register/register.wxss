.register-page {
  position: relative;
  width: 750rpx;
  height: 100vh;
  overflow: hidden;
  background: #fff8ec;
  color: #4d320c;
}

.page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: auto;
  z-index: 0;
  pointer-events: none;
}

.register-scroll {
  position: relative;
  z-index: 2;
  width: 750rpx;
  height: 100vh;
}

.register-content {
  position: relative;
  width: 750rpx;
  min-height: 1320rpx;
  padding: 110rpx 34rpx 80rpx;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.back {
  position: fixed;
  left: 28rpx;
  top: 58rpx;
  z-index: 20;
  width: 72rpx;
  height: 72rpx;
  line-height: 62rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: rgba(255, 253, 247, 0.96);
  border: 2rpx solid #ead79f;
  color: #6a4308;
  font-size: 58rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 22rpx rgba(145, 101, 32, 0.16);
}

.register-card {
  margin-top: 260rpx;
  padding: 34rpx 30rpx 38rpx;
  border-radius: 34rpx;
  background: rgba(255, 253, 247, 0.96);
  border: 2rpx solid rgba(232, 202, 134, 0.78);
  box-shadow: 0 18rpx 44rpx rgba(145, 101, 32, 0.13);
  box-sizing: border-box;
}

.register-avatar-row {
  margin: 24rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.register-avatar {
  flex: none;
  width: 112rpx !important;
  min-width: 112rpx !important;
  max-width: 112rpx !important;
  height: 112rpx !important;
  min-height: 112rpx !important;
  max-height: 112rpx !important;
  padding: 0 !important;
  margin: 0 auto !important;
  line-height: 112rpx !important;
  border-radius: 50% !important;
  overflow: hidden !important;
  box-sizing: border-box;
  background: #fff1c2;
  border: 4rpx solid #ffd260;
  box-shadow: 0 10rpx 24rpx rgba(145, 101, 32, 0.16);
}

.register-avatar-img { display:block; width:100%; height:100%; border-radius:50%; }
.register-avatar-tip { margin-top: 10rpx; color: #9a7c48; font-size: 24rpx; font-weight: 700; }

.security-option {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: #fff8e8;
  border: 2rpx solid #efd99f;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.security-title { color: #5f3a06; font-size: 28rpx; font-weight: 900; }
.security-desc { margin-top: 6rpx; color: #967a4d; font-size: 23rpx; line-height: 1.45; }

.register-title {
  color: #4d320c;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 900;
  text-align: center;
}

.register-subtitle {
  margin-top: 12rpx;
  color: #8c6f3c;
  font-size: 27rpx;
  line-height: 1.5;
  font-weight: 800;
  text-align: center;
}

.role-switch {
  display: flex;
  gap: 18rpx;
  margin: 28rpx 0 22rpx;
}

.role-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: 38rpx;
  background: #fff8ec;
  border: 2rpx solid #ead7ae;
  color: #7c570e;
  font-size: 30rpx;
  font-weight: 900;
}

.role-btn.active {
  background: linear-gradient(180deg, #ffe28a 0%, #ffc94a 100%);
  border-color: #ffc94a;
  color: #5f3a06;
}

.form-field {
  width: 100%;
  height: 82rpx;
  margin-top: 18rpx;
  padding: 0 28rpx;
  border-radius: 41rpx;
  background: #fff8ec;
  border: 2rpx solid rgba(232, 202, 134, 0.65);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.bind-code-field {
  border-color: #ffc94a;
  background: #fff4d8;
}

.input-text {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  color: #4d320c;
  font-size: 30rpx;
  font-weight: 800;
}

.input-placeholder {
  color: #b8a077;
  font-weight: 700;
}

.role-note {
  margin: 20rpx 4rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #fff1c2;
  color: #7a520f;
  font-size: 27rpx;
  line-height: 1.55;
  font-weight: 900;
}

.submit-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  margin: 28rpx 0 0;
  border-radius: 42rpx;
  background: linear-gradient(180deg, #ffe28a 0%, #ffc94a 100%);
  color: #603d08;
  font-size: 32rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 22rpx rgba(184, 116, 20, 0.16);
}

.login-link {
  width: 100%;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0;
  margin: 18rpx 0 0;
  border-radius: 35rpx;
  background: transparent;
  color: #8a6819;
  font-size: 28rpx;
  font-weight: 900;
}

/* ========== 全局字号适配 ========== */
