.term-popup-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9000;
  pointer-events: none;
}

.term-popup-card {
  position: absolute;
  width: 680rpx;
  max-height: 760rpx;
  padding: 22rpx 24rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 253, 247, 0.98);
  border: 2rpx solid rgba(232, 202, 134, 0.92);
  box-shadow: 0 18rpx 46rpx rgba(91, 58, 15, 0.18);
  box-sizing: border-box;
  pointer-events: auto;
  overflow-y: auto;
  left: 35rpx !important;
}

.term-popup-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 64rpx;
  padding-right: 88rpx;
  box-sizing: border-box;
}

.term-popup-title {
  flex: 1;
  min-width: 0;
  color: #4d320c;
  font-size: 33rpx;
  line-height: 1.28;
  font-weight: 900;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.term-popup-close {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 40rpx;
  min-width: 0;
  height: 60rpx;
  padding: 0;
  margin: 0;
  border-radius: 30rpx;
  border: 2rpx solid rgba(232, 202, 134, 0.8);
  background: rgba(255, 255, 255, 0.98);
  color: #7c570e;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12);
  z-index: 99999;
}

.term-popup-close::after {
  border: none;
}

.term-popup-content {
  margin-top: 14rpx;
  color: #5c3c0f;
  font-size: 28rpx;
  line-height: 1.56;
  font-weight: 700;
}

.term-popup-tip {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #fff4d8;
  color: #8a5b12;
  font-size: 25rpx;
  line-height: 1.5;
  font-weight: 800;
}

.term-popup-loading {
  margin-top: 12rpx;
  color: #9b835a;
  font-size: 24rpx;
  font-weight: 800;
}

.term-popup-ask {
  margin: 16rpx 0 0;
  width: 180rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffe28a 0%, #ffc94a 100%);
  color: #603d08;
  font-size: 25rpx;
  font-weight: 900;
}

.term-popup-ask::after {
  border: none;
}

.term-popup-chat {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 20rpx;
  background: #fff8ea;
  border: 1rpx solid rgba(232, 202, 134, 0.72);
  box-sizing: border-box;
}

.term-chat-list {
  max-height: 260rpx;
  min-height: 120rpx;
}

.term-chat-msg {
  margin-bottom: 12rpx;
}

.term-chat-msg.user {
  text-align: right;
}

.term-chat-name {
  color: #9b6c14;
  font-size: 21rpx;
  line-height: 1.25;
  font-weight: 900;
}

.term-chat-bubble {
  display: inline-block;
  max-width: 500rpx;
  margin-top: 4rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: #fffdf7;
  color: #5c3c0f;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 800;
  text-align: left;
  box-sizing: border-box;
}

.term-chat-msg.user .term-chat-bubble {
  background: #ffe08a;
  color: #5a3a0c;
}

.term-chat-input-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.term-chat-input {
  flex: 1;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 32rpx;
  background: #fffdf7;
  color: #4d320c;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.term-chat-ph {
  color: #b39b72;
}

.term-chat-send {
  flex: none;
  width: 104rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  margin: 0;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #ffe28a 0%, #ffc94a 100%);
  color: #603d08;
  font-size: 24rpx;
  font-weight: 900;
}

.term-chat-send::after {
  border: none;
}

/* 全局字体适配 - 大字模式 */
.font-global-large .term-popup-title { font-size: 40rpx; }
.font-global-large .term-popup-content { font-size: 34rpx; }
.font-global-large .term-popup-tip { font-size: 30rpx; }
.font-global-large .term-popup-loading { font-size: 28rpx; }
.font-global-large .term-popup-ask { font-size: 30rpx; }
.font-global-large .term-chat-name { font-size: 26rpx; }
.font-global-large .term-chat-bubble { font-size: 30rpx; }
.font-global-large .term-chat-input { font-size: 30rpx; }
.font-global-large .term-chat-send { font-size: 30rpx; }

/* 全局字体适配 - 超大字模式 */
.font-global-xlarge .term-popup-title { font-size: 48rpx; }
.font-global-xlarge .term-popup-content { font-size: 40rpx; }
.font-global-xlarge .term-popup-tip { font-size: 36rpx; }
.font-global-xlarge .term-popup-loading { font-size: 32rpx; }
.font-global-xlarge .term-popup-ask { font-size: 36rpx; }
.font-global-xlarge .term-chat-name { font-size: 30rpx; }
.font-global-xlarge .term-chat-bubble { font-size: 36rpx; }
.font-global-xlarge .term-chat-input { font-size: 36rpx; }
.font-global-xlarge .term-chat-send { font-size: 36rpx; }
.font-global-large view,
.font-global-large text,
.font-global-large button,
.font-global-large input { font-size: 32rpx !important; }
.font-global-xlarge view,
.font-global-xlarge text,
.font-global-xlarge button,
.font-global-xlarge input { font-size: 37rpx !important; }
