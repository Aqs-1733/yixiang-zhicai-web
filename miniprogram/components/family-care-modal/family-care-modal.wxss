.care-mask{position:fixed;inset:0;z-index:6000;padding:150rpx 28rpx calc(38rpx + env(safe-area-inset-bottom));display:flex;align-items:flex-start;justify-content:center;background:rgba(58,43,18,.38);box-sizing:border-box}.care-dialog{position:relative;width:100%;max-height:calc(100vh - 210rpx);padding:32rpx 28rpx 28rpx;border-radius:30rpx;background:#fffdf7;border:2rpx solid #ead79f;box-shadow:0 22rpx 60rpx rgba(68,45,10,.26);box-sizing:border-box}.care-close{position:absolute;right:20rpx;top:18rpx;width:62rpx;height:62rpx;line-height:58rpx;border-radius:50%;background:#fff4d8;border:2rpx solid #ead79f;text-align:center;color:#6a4308;font-size:38rpx;font-weight:900}.care-heading{padding-right:80rpx;color:#4d320c;font-size:40rpx;font-weight:900}.care-status{margin-top:24rpx;padding:28rpx;border-radius:22rpx;background:#fff6dc;color:#7e6843;font-size:27rpx;line-height:1.55;font-weight:800}.care-status.denied{background:#fff0e8;color:#9c5338}.care-scroll{height:calc(100vh - 320rpx);margin-top:20rpx}.care-section{margin-bottom:16rpx;padding:20rpx;border-radius:22rpx;background:linear-gradient(145deg,#fbfff8,#edf8e8);border:2rpx solid #d7e8ca}.care-section.meal{background:linear-gradient(145deg,#fffdf8,#fff3d8);border-color:#eed69d}.care-section.exercise{background:linear-gradient(145deg,#fafffd,#e5f4ef);border-color:#c6ded6}.care-title{color:#405530;font-size:31rpx;font-weight:900}.care-empty{padding:18rpx 0 4rpx;color:#8b7957;font-size:25rpx}.care-row{display:flex;justify-content:space-between;gap:18rpx;padding:17rpx 0;border-top:1rpx solid rgba(154,185,131,.34);color:#3e4b2f;font-size:28rpx;font-weight:900}.care-row view view{margin-top:4rpx;color:#748164;font-size:23rpx}.care-right{text-align:right}.care-right text{display:block;margin-top:5rpx;color:#568044;font-size:22rpx}.journal{padding:17rpx 0;border-top:1rpx solid rgba(203,177,116,.34)}.journal text{color:#49391c;font-size:27rpx;font-weight:900}.journal view{margin-top:6rpx;color:#705f3e;font-size:24rpx;line-height:1.5}.journal .journal-time{color:#9b8968;font-size:20rpx;text-align:right}.location-card{margin-top:24rpx;padding:34rpx 24rpx;border-radius:26rpx;background:linear-gradient(145deg,#fbfff9,#e5f4e2);border:2rpx solid #c9e1bd;text-align:center}.location-dot{width:80rpx;height:80rpx;line-height:80rpx;margin:0 auto;border-radius:50%;background:linear-gradient(135deg,#bfe6a9,#75bd68);color:#fff;font-size:36rpx}.location-title{margin-top:18rpx;color:#456234;font-size:27rpx;font-weight:900}.location-address{margin-top:18rpx;color:#2f3e27;font-size:36rpx;line-height:1.5;font-weight:900}.location-time{margin-top:15rpx;color:#748267;font-size:23rpx}
